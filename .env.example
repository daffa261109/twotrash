# Token API, harus sama dengan API_TOKEN di server.
API_TOKEN=

# Alamat pengirim foto. Ubah hanya kalau server pindah.
API_ENDPOINT=https://twotrash.wbesoft.com/classify

# Kamera pengganti: webcam USB UVC dengan lensa wide secara fisik.
# Pilih path /dev/v4l/by-id/...-video-index0 jika tersedia (stabil saat reboot).
CAMERA_BACKEND=usb
CAMERA_DEVICE=/dev/video0
CAMERA_FPS=15
# Kamera pita lama masih didukung dengan CAMERA_BACKEND=csi.

# Servo 1 setelah jawaban API. Ubah angka ini, lalu jalankan ulang program.
SERVO1_TUNGGU=5
SERVO1_ORGANIK=-60
SERVO1_NONORGANIK=-90
SERVO1_LAINNYA=180
SERVO1_KEMBALI=60
