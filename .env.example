# Token API, harus sama dengan API_TOKEN di server.
API_TOKEN=

# Alamat pengirim foto. Ubah hanya kalau server pindah.
API_ENDPOINT=https://twotrash.wbesoft.com/classify

# Kamera pengganti: webcam USB UVC dengan lensa wide secara fisik.
# Pilih path /dev/v4l/by-id/...-video-index0 jika tersedia (stabil saat reboot).
CAMERA_BACKEND=usb
CAMERA_DEVICE=/dev/video0
CAMERA_FPS=15
# 1 = buka jendela monitor. 0 = matikan, Pi Zero lebih ringan. OLED tetap jalan.
SHOW_MONITOR=0
# Kamera pita lama masih didukung dengan CAMERA_BACKEND=csi.

# HC-SR04, dalam sentimeter. 56–58 = penampang kosong. Lebih dekat = ada barang.
HC_BARANG_MIN=2
HC_PENAMPANG_MIN=56
HC_PENAMPANG_MAX=58

# Setelah jawaban API. Ubah angka ini, lalu jalankan ulang program.
# SERVO_KECEPATAN = derajat per detik. SERVO2_BUANG = sudut buang servo 2.
# ORGANIK: servo 1 ke 180, servo 2 ke -60, lalu keduanya kembali.
# NONORGANIK: servo 1 ke -90, servo 2 ke -45, lalu keduanya kembali.
# LAINNYA: servo 1 diam, servo 2 langsung ke 145, lalu servo 2 kembali.
SERVO_KECEPATAN=45
SERVO1_TUNGGU=2
SERVO2_TUNGGU=3
SERVO2_BUANG=150
SERVO2_ORGANIK=-60
SERVO2_NONORGANIK=-45
SERVO2_LAINNYA=145
SERVO1_ORGANIK=180
SERVO1_NONORGANIK=-90
SERVO1_KEMBALI=60
SERVO2_KEMBALI=45
